# Cani server environment — copy to .env (never commit .env).
# PayPal (sandbox first): developer.paypal.com → Apps & Credentials → Sandbox
CANI_PAYPAL_CLIENT_ID=
CANI_PAYPAL_CLIENT_SECRET=
CANI_PAYPAL_MODE=sandbox
# After deploying + `bun run register-webhook`:
CANI_PAYPAL_WEBHOOK_ID=
CANI_PUBLIC_URL=https://your-cani-url.example
# AI narration + drafting (optional; offline fallbacks work without it).
# Any OpenAI-compatible endpoint, or set GEMINI_API_KEY instead.
CANI_AI_API_KEY=
CANI_AI_BASE_URL=https://api.openai.com/v1
CANI_AI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
# Server
PORT=8787
CANI_DATA_DIR=data
